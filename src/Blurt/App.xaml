<Application x:Class="Blurt.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Light"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>

        <!--
            A drawing on trace paper: graphite lines on a faint grid, and red pencil, the architect's
            redline, only for what is live.
        -->
        <SolidColorBrush x:Key="Paper" Color="#EEF0EC" />
        <SolidColorBrush x:Key="PaperLit" Color="#F8F9F6" />
        <SolidColorBrush x:Key="GridLine" Color="#DCE0DA" />
        <SolidColorBrush x:Key="Rule" Color="#BCC1BA" />
        <SolidColorBrush x:Key="Ink" Color="#23262B" />
        <SolidColorBrush x:Key="Pencil" Color="#5E636B" />
        <SolidColorBrush x:Key="Faint" Color="#6E737B" />
        <SolidColorBrush x:Key="Redline" Color="#D0342C" />
        <SolidColorBrush x:Key="RedlineDeep" Color="#A82820" />
        <SolidColorBrush x:Key="LedOff" Color="#C2C7C0" />
        <SolidColorBrush x:Key="Scrim" Color="#B3EEF0EC" />

        <!-- Graph paper: one faint line every 24 px. -->
        <DrawingBrush x:Key="GraphPaper" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute"
                      Viewbox="0,0,24,24" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#EEF0EC">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,24,24" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#DFE3DD">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,24,1" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#DFE3DD">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,24" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Section hatching in red pencil, drawn over the part of a sound that has played. -->
        <DrawingBrush x:Key="RedHatch" TileMode="Tile" Viewport="0,0,7,7" ViewportUnits="Absolute"
                      Viewbox="0,0,7,7" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen><Pen Brush="#D0342C" Thickness="1" /></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><LineGeometry StartPoint="-1,8" EndPoint="8,-1" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!--
            The mark: a speech bubble with a 45-degree foot, holding the waveform of a sound that hits
            and fades. Assets/blurt.ico and docs/logo.svg draw it in red with paper bars, because ink
            vanishes on a dark taskbar. Here the bubble is ink and only the peak is red, since red marks
            what is live. The 28 x 28 box, kept by the transparent square, puts every edge on a whole pixel.
        -->
        <DrawingImage x:Key="LogoMark">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H28 V28 H0 Z" />
                    <GeometryDrawing Brush="#23262B" Geometry="M1,1 H27 V21 H7 L1,27 Z" />
                    <GeometryDrawing Brush="#EEF0EC" Geometry="M5,7 H8 V15 H5 Z M15,5 H18 V17 H15 Z M20,8 H23 V14 H20 Z" />
                    <GeometryDrawing Brush="#D0342C" Geometry="M10,3 H13 V19 H10 Z" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Fluent draws sliders, focus marks and selections in the accent colour; here they are graphite. -->
        <Color x:Key="{x:Static SystemColors.AccentColorKey}">#23262B</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorLight1Key}">#3A3E44</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorLight2Key}">#4C5158</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorLight3Key}">#5E636B</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorDark1Key}">#23262B</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorDark2Key}">#1A1C20</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorDark3Key}">#121417</Color>

        <FontFamily x:Key="UiFont">Bahnschrift</FontFamily>
        <FontFamily x:Key="NarrowFont">Bahnschrift SemiCondensed</FontFamily>
        <FontFamily x:Key="LightFont">Bahnschrift Light</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Pencil}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SmallPrint" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NarrowFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Pencil}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Keyboard focus: a dashed construction line around the control. -->
        <Style x:Key="FocusRing" TargetType="Rectangle">
            <Setter Property="Margin" Value="-4" />
            <Setter Property="Stroke" Value="{StaticResource Ink}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeDashArray" Value="3 2" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- An outlined box. Background is the fill, BorderBrush the line. -->
        <Style x:Key="Key" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource Paper}" />
            <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Face" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <!-- Drawn over the face so hovering never changes the button's size. -->
                            <Rectangle x:Name="Ledge" Height="3" VerticalAlignment="Bottom" Visibility="Collapsed"
                                       Fill="{TemplateBinding BorderBrush}" />
                            <Rectangle x:Name="Focus" Style="{StaticResource FocusRing}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ledge" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Ledge" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryKey" TargetType="Button" BasedOn="{StaticResource Key}">
            <Setter Property="Background" Value="{StaticResource Ink}" />
            <Setter Property="Foreground" Value="{StaticResource Paper}" />
        </Style>

        <Style x:Key="Quiet" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Pencil}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Rectangle x:Name="Focus" Style="{StaticResource FocusRing}" Margin="-2" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#14000000" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- An on/off switch: a square that is filled when on. Tag is the fill. -->
        <Style x:Key="LedKey" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Tag" Value="{StaticResource Ink}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid SnapsToDevicePixels="True" Background="Transparent">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Border x:Name="Box" Width="14" Height="14" BorderBrush="{StaticResource Ink}" BorderThickness="1"
                                        Padding="2" VerticalAlignment="Center">
                                    <Rectangle x:Name="Fill" Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Border>
                                <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Rectangle x:Name="Focus" Style="{StaticResource FocusRing}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Fill" Property="Visibility" Value="Hidden" />
                                <Setter Property="Foreground" Value="{StaticResource Pencil}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Box" Property="Padding" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A sound drawn as a room in plan. Background is the room's fill, BorderBrush its wall line. -->
        <Style x:Key="Pad" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource Paper}" />
            <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- The wall is drawn over the content at a fixed inset, so a thicker wall never moves it. -->
                        <Grid SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" />
                            <ContentPresenter Margin="1" />
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    IsHitTestVisible="False" />
                            <Rectangle x:Name="Focus" Style="{StaticResource FocusRing}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PaperLit}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Sheet" TargetType="Border">
            <Setter Property="Width" Value="440" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Background" Value="{StaticResource Paper}" />
            <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="SheetTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource LightFont}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </Application.Resources>
</Application>
