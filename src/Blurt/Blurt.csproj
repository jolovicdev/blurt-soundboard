<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationIcon>Assets\blurt.ico</ApplicationIcon>
    <Product>Blurt</Product>
    <Version>0.1.0</Version>
    <Copyright>Copyright (c) 2026 Dušan Jolović</Copyright>
    <!-- WPF still marks ThemeMode (the Fluent styles) as experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="NAudio.Vorbis" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\blurt.ico" />
    <None Include="..\..\gallery\**\*.ogg" Link="gallery\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\gallery\LICENSE" Link="gallery\LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
